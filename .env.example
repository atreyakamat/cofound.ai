# ─────────────────────────────────────────────────────────────────────
# CofounderAI — Environment Variables
# Copy this file: cp .env.example .env   then fill in real values.
# ─────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Free options: Neon (neon.tech) · Supabase (supabase.com) · Railway
DATABASE_URL="postgresql://postgres:password@localhost:5432/cofound_ai"

# ── NextAuth ──────────────────────────────────────────────────────────
# Generate secret:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────
# AI Provider Configuration
#
# Set AI_PROVIDER to one of:
#   ollama | openai | anthropic | google | groq | openrouter | custom
#
# If not set, auto-detects based on which keys are present.
# Detection priority (local-first):
#   Ollama → Anthropic → Google → Groq → OpenRouter → OpenAI → Custom
#
# Default: ollama (works locally with no API key)
# ─────────────────────────────────────────────────────────────────────
# AI_PROVIDER="ollama"

# ── Option 1: Ollama — LOCAL FIRST (fully offline, no API cost) ──────
# Install: https://ollama.com
# Pull a model:  ollama pull llama3.2
# PRIORITIZED — Ollama is detected first when OLLAMA_BASE_URL is set.
#
OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_FAST_MODEL="llama3.2"
# OLLAMA_REASONING_MODEL="llama3.2"
#
# Enable JSON mode (supported on llama3.2+, mistral, qwen2.5):
# OLLAMA_JSON_MODE="true"
#
# Recommended Ollama models:
# OLLAMA_FAST_MODEL="qwen2.5:7b"
# OLLAMA_REASONING_MODEL="qwen2.5:32b"
# OLLAMA_REASONING_MODEL="deepseek-r1:8b"
# OLLAMA_REASONING_MODEL="mistral:latest"

# ── Option 2: Anthropic (Claude — direct API) ────────────────────────
# Get your key: https://console.anthropic.com/settings/keys
# Then set: AI_PROVIDER=anthropic
#
# ANTHROPIC_API_KEY="sk-ant-..."
#
# Default models:
#   Fast:      claude-3-5-haiku-20241022
#   Reasoning: claude-sonnet-4-20250514
#
# Override:
# ANTHROPIC_FAST_MODEL="claude-3-5-haiku-20241022"
# ANTHROPIC_REASONING_MODEL="claude-sonnet-4-20250514"
#
# Custom base URL (for proxies, AWS Bedrock adapter, etc.):
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# ── Option 3: Google Gemini (direct API) ──────────────────────────────
# Get your key: https://aistudio.google.com/apikey
# Then set: AI_PROVIDER=google
#
# GOOGLE_AI_API_KEY="AIza..."
# or:
# GEMINI_API_KEY="AIza..."
#
# Default models:
#   Fast:      gemini-2.0-flash
#   Reasoning: gemini-2.0-flash

# ── Option 4: Groq (ultra-fast open model inference) ─────────────────
# Get your key: https://console.groq.com/keys
# Then set: AI_PROVIDER=groq
#
# GROQ_API_KEY="gsk_..."
#
# Default models:
#   Fast:      llama-3.3-70b-versatile
#   Reasoning: llama-3.3-70b-versatile

# ── Option 5: OpenAI ─────────────────────────────────────────────────
# Get your key: https://platform.openai.com/api-keys
#
# OPENAI_API_KEY="sk-..."
#
# Default models:
#   Fast:      gpt-4o-mini
#   Reasoning: gpt-4o

# ── Option 6: OpenRouter (any model, one API key) ────────────────────
# Gives access to OpenAI, Anthropic, Google, Meta, Mistral and more.
# Get your key: https://openrouter.ai/keys
# Then set: AI_PROVIDER=openrouter
#
# OPENROUTER_API_KEY="sk-or-..."
#
# Default models:
#   Fast:      openai/gpt-4o-mini
#   Reasoning: openai/gpt-4o
#
# Popular alternatives:
# OPENROUTER_FAST_MODEL="anthropic/claude-3-haiku"
# OPENROUTER_REASONING_MODEL="anthropic/claude-3-5-sonnet"
# OPENROUTER_REASONING_MODEL="google/gemini-2.0-flash"
# OPENROUTER_REASONING_MODEL="meta-llama/llama-3.3-70b-instruct"
# OPENROUTER_REASONING_MODEL="deepseek/deepseek-r1"

# ── Option 7: Custom (any OpenAI-compatible endpoint) ────────────────
# Works with: LM Studio, vLLM, Together AI, Fireworks, text-gen-webui, etc.
# Then set: AI_PROVIDER=custom
#
# CUSTOM_AI_BASE_URL="http://localhost:1234/v1"
# CUSTOM_AI_API_KEY="optional-key"
# CUSTOM_AI_JSON_MODE="true"

# ── Model overrides (apply to ANY provider) ───────────────────────────
# These take highest priority — override the fast/reasoning model regardless:
# AI_MODEL_FAST="gpt-4o-mini"
# AI_MODEL_REASONING="gpt-4o"

# ─────────────────────────────────────────────────────────────────────
# First-time setup:
#   1. cp .env.example .env
#   2. Fill in DATABASE_URL, NEXTAUTH_SECRET, and your chosen AI keys
#   3. npx prisma db push         → create all tables
#   4. npm run db:seed            → (optional) load demo data
#   5. npm run dev                → http://localhost:3000
# ─────────────────────────────────────────────────────────────────────

